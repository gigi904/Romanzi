    <!-- SCRIPT JAVASCRIPT PRINCIPALE -->
    <script>
        // Data XML di Esempio Predefinita (Struttura Anagrafica Classe 5A)
        const sampleXmlData = `<?xml version="1.0" encoding="UTF-8"?>
<classe anno="5" sezione="A" indirizzo="Informatica e Telecomunicazioni">
