            <cognome>Esposito</cognome>
            <data_nascita>2005-01-18</data_nascita>
            <codice_fiscale>SPSSFO05A58F205X</codice_fiscale>
            <email>sofia.esposito@scuola.it</email>
            <citta>Bergamo</citta>
            <media_voti>6.8</media_voti>
            <note>Membro del Consiglio</note>
        </studente>
        <studente id="5">
            <nome>Luca</nome>
            <cognome>Romano</cognome>
            <data_nascita>2005-06-30</data_nascita>
            <codice_fiscale>RMNLCU05H30H501J</codice_fiscale>
            <email>luca.romano@scuola.it</email>
            <citta>Monza</citta>
            <media_voti>5.5</media_voti>
            <note>Recupero programmato</note>
        </studente>
        <studente id="6">
            <nome>Chiara</nome>
            <cognome>Colombo</cognome>
            <data_nascita>2005-08-14</data_nascita>
            <codice_fiscale>CLMCHR05M54H501W</codice_fiscale>
            <email>chiara.colombo@scuola.it</email>
            <citta>Sesto San Giovanni</citta>
            <media_voti>8.9</media_voti>
            <note>Certificazione English C1</note>
        </studente>
        <studente id="7">
            <nome>Matteo</nome>
            <cognome>Ricci</cognome>
            <data_nascita>2004-12-05</data_nascita>
            <codice_fiscale>RCCMTT04T05F205P</codice_fiscale>
            <email>matteo.ricci@scuola.it</email>
            <citta>Bergamo</citta>
            <media_voti>7.9</media_voti>
            <note>Atleta agonista</note>
        </studente>
        <studente id="8">
            <nome>Elena</nome>
            <cognome>Marini</cognome>
            <data_nascita>2005-03-22</data_nascita>
            <codice_fiscale>MRNLNE05C62H501Q</codice_fiscale>
            <email>elena.marini@scuola.it</email>
            <citta>Milano</citta>
            <media_voti>9.5</media_voti>
            <note>Capoclasse</note>
        </studente>
    </studenti>
</classe>`;

        // Stato Globale dell'applicazione
        let rawXmlString = sampleXmlData;
        let studentsList = [];
        let filteredStudents = [];
        let currentSort = { column: 'cognome', direction: 'asc' };

        // Inizializzazione all'avvio della pagina
        window.onload = function() {
            // Carica la stringa predefinita tramite simulazione XMLHttpRequest
            loadDefaultXmlXHR();

            // Event listener per l'editor XML
            const textarea = document.getElementById('xml-textarea');
            textarea.addEventListener('input', debounce(handleEditorInput, 400));
        };

        /**
         * 1. CARICAMENTO Dati XML tramite XMLHttpRequest (XHR)
         * Utilizza un oggetto Blob per creare una richiesta HTTP asincrona reale senza blocchi CORS.
         */
        function loadDefaultXmlXHR() {
            showLoading(true);

            // Creazione del Blob per simulare un URL di un file locale / server
            const blob = new Blob([sampleXmlData], { type: 'text/xml' });
            const blobUrl = URL.createObjectURL(blob);

            // Utilizzo dell'oggetto XMLHttpRequest standard
            const xhr = new XMLHttpRequest();
            xhr.open("GET", blobUrl, true);

            xhr.onload = function() {
                showLoading(false);
                if (xhr.status === 200 || xhr.status === 0) {
                    rawXmlString = xhr.responseText;
                    document.getElementById('xml-textarea').value = rawXmlString;
                    parseAndProcessXml(rawXmlString);
                    showToast("Dati XML caricati con successo tramite XMLHttpRequest!", "success");
                } else {
                    showToast("Errore durante la richiesta XHR: " + xhr.status, "error");
                }
                URL.revokeObjectURL(blobUrl);
            };

            xhr.onerror = function() {
                showLoading(false);
                showToast("Errore di rete durante la richiesta XHR.", "error");
                URL.revokeObjectURL(blobUrl);
            };

            // Invio della richiesta asincrona
            xhr.send();
        }

        /**
         * 2. UPLOAD DI UN FILE XML PERSONALIZZATO
         */
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            if (file.type !== "text/xml" && !file.name.endsWith('.xml')) {
                showToast("Seleziona un file valido con estensione .xml", "warning");
                return;
            }

            const reader = new FileReader();
            showLoading(true);

            reader.onload = function(e) {
                showLoading(false);
                rawXmlString = e.target.result;
                document.getElementById('xml-textarea').value = rawXmlString;
                
                if (parseAndProcessXml(rawXmlString)) {
                    showToast(`File "${file.name}" caricato correttamente!`, "success");
                }
            };

            reader.onerror = function() {
                showLoading(false);
                showToast("Errore nella lettura del file selezionale.", "error");
            };

            reader.readAsText(file);
            // Reset dell'input file
            event.target.value = '';
        }

        /**
         * 3. PARSING DELL'XML E ESTRAZIONE DATI (DOMParser)
         */
        function parseAndProcessXml(xmlText) {
            const parser = new DOMParser();
            const xmlDoc = parser.parseFromString(xmlText, "text/xml");

            // Controllo Sintattico Errore di Parsing
            const parserError = xmlDoc.getElementsByTagName("parsererror");
            const errorBox = document.getElementById("xml-error-box");
            const statusBadge = document.getElementById("xml-status-badge");

            if (parserError.length > 0) {
                const errorMsg = parserError[0].textContent;
                errorBox.classList.remove("hidden");
                document.getElementById("xml-error-msg").textContent = errorMsg.split('\n')[0];
                
                statusBadge.className = "ml-2 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-500/20 text-red-300 border border-red-500/30";
                statusBadge.textContent = "Errore XML";
                return false;
            }

            // XML Valido
            errorBox.classList.add("hidden");
            statusBadge.className = "ml-2 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30";
            statusBadge.textContent = "XML Valido";

            // Estrazione record dei singoli studenti
            const studentNodes = xmlDoc.getElementsByTagName("studente");
            const parsedList = [];

            for (let i = 0; i < studentNodes.length; i++) {
                const node = studentNodes[i];
                
                // Helper per leggere tag sicuri
                const getVal = (tagName) => {
                    const el = node.getElementsByTagName(tagName)[0];
                    return el ? el.textContent.trim() : "";
                };

                parsedList.push({
                    id: node.getAttribute("id") || (i + 1).toString(),
                    nome: getVal("nome"),
                    cognome: getVal("cognome"),
                    dataNascita: getVal("data_nascita"),
                    codiceFiscale: getVal("codice_fiscale"),
                    email: getVal("email"),
                    citta: getVal("citta"),
                    mediaVoti: parseFloat(getVal("media_voti")) || 0,
                    note: getVal("note")
                });
            }

            studentsList = parsedList;
            populateCityFilterOptions();
            applyFilters();
            updateKPIs();
            return true;
        }

        /**
         * 4. GESTIONE FILTRI E ORDINAMENTO
         */
        function applyFilters() {
            const searchQuery = document.getElementById('search-input').value.toLowerCase().trim();
            const selectedCity = document.getElementById('city-filter').value;
            const minGpa = parseFloat(document.getElementById('gpa-filter').value) || 0;

            filteredStudents = studentsList.filter(student => {
                // Filtro Ricerca Globale
                const matchesSearch = 
                    student.nome.toLowerCase().includes(searchQuery) ||
                    student.cognome.toLowerCase().includes(searchQuery) ||
                    student.codiceFiscale.toLowerCase().includes(searchQuery) ||
                    student.email.toLowerCase().includes(searchQuery) ||
                    student.citta.toLowerCase().includes(searchQuery) ||
                    student.note.toLowerCase().includes(searchQuery);

                // Filtro Città
                const matchesCity = !selectedCity || student.citta === selectedCity;

                // Filtro Media Voti
                const matchesGpa = student.mediaVoti >= minGpa;

                return matchesSearch && matchesCity && matchesGpa;
            });

            // Applica l'ordinamento corrente
            sortDataArray(filteredStudents, currentSort.column, currentSort.direction);

            // Renderizza la tabella
            renderTable(filteredStudents);
        }

        function sortTable(column) {
            if (currentSort.column === column) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            } else {
                currentSort.column = column;
                currentSort.direction = 'asc';
            }
            updateSortIcons();
            applyFilters();
        }

        function sortDataArray(arr, column, direction) {
            arr.sort((a, b) => {
                let valA = a[column];
                let valB = b[column];

                if (typeof valA === 'string') {
                    valA = valA.toLowerCase();
                    valB = valB.toLowerCase();
                }

                if (valA < valB) return direction === 'asc' ? -1 : 1;
                if (valA > valB) return direction === 'asc' ? 1 : -1;
                return 0;
            });
        }

        function updateSortIcons() {
            const columns = ['nome', 'dataNascita', 'codiceFiscale', 'email', 'citta', 'mediaVoti'];
            columns.forEach(col => {
                const icon = document.getElementById(`sort-icon-${col}`);
                if (!icon) return;
                
                if (col === currentSort.column) {
                    icon.className = `fa-solid fa-sort-${currentSort.direction === 'asc' ? 'up' : 'down'} text-indigo-600 text-xs`;
                } else {
                    icon.className = 'fa-solid fa-sort text-slate-400 text-xs';
                }
            });
        }

        function resetFilters() {
            document.getElementById('search-input').value = '';
            document.getElementById('city-filter').value = '';
            document.getElementById('gpa-filter').value = '0';
            applyFilters();
            showToast("Filtri azzerati", "info");
        }

        /**
         * 5. RENDERING TABELLA HTML
         */
        function renderTable(data) {
            const tbody = document.getElementById('table-body');
            const emptyState = document.getElementById('empty-state');
            tbody.innerHTML = '';

            document.getElementById('showing-count').textContent = data.length;
            document.getElementById('total-count').textContent = studentsList.length;

            if (data.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            data.forEach(student => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/80 transition-colors border-b border-slate-100';

                // Badge Voto stilizzato
                let gpaBadgeClass = "bg-rose-100 text-rose-700 border-rose-200";
                if (student.mediaVoti >= 8.0) {
                    gpaBadgeClass = "bg-emerald-100 text-emerald-800 border-emerald-200";
                } else if (student.mediaVoti >= 6.0) {
                    gpaBadgeClass = "bg-blue-100 text-blue-800 border-blue-200";
                }

                tr.innerHTML = `
                    <td class="py-3 px-4 font-medium text-slate-900 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold text-xs flex items-center justify-center">
                                ${escapeHtml(student.nome.charAt(0))}${escapeHtml(student.cognome.charAt(0))}
                            </div>
                            <div>
                                <span class="font-semibold block">${escapeHtml(student.nome)} ${escapeHtml(student.cognome)}</span>
                                <span class="text-xs text-slate-400 block sm:hidden">${escapeHtml(student.email)}</span>
                            </div>
                        </div>
                    </td>
                    <td class="py-3 px-4 text-slate-600 whitespace-nowrap hidden md:table-cell">
                        ${formatDate(student.dataNascita)}
                    </td>
                    <td class="py-3 px-4 text-slate-600 font-mono text-xs whitespace-nowrap hidden lg:table-cell">
                        <span class="bg-slate-100 px-2 py-1 rounded border border-slate-200">${escapeHtml(student.codiceFiscale)}</span>
                    </td>
                    <td class="py-3 px-4 text-slate-600 whitespace-nowrap hidden sm:table-cell">
                        <a href="mailto:${escapeHtml(student.email)}" class="text-indigo-600 hover:underline flex items-center gap-1.5">
                            <i class="fa-regular fa-envelope text-xs"></i> ${escapeHtml(student.email)}
                        </a>
                    </td>
                    <td class="py-3 px-4 text-slate-600 whitespace-nowrap">
                        <span class="inline-flex items-center gap-1">
                            <i class="fa-solid fa-location-dot text-slate-400 text-xs"></i> ${escapeHtml(student.citta)}
                        </span>
                    </td>
                    <td class="py-3 px-4 whitespace-nowrap">
                        <span class="px-2.5 py-1 rounded-full text-xs font-bold border ${gpaBadgeClass}">
                            ${student.mediaVoti.toFixed(1)}
                        </span>
                    </td>
                    <td class="py-3 px-4 text-slate-500 text-xs max-w-xs truncate">
                        ${student.note ? `<span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded border border-slate-200">${escapeHtml(student.note)}</span>` : '<span class="text-slate-300">-</span>'}
                    </td>
                `;

                tbody.appendChild(tr);
            });
        }

        /**
         * 6. UPDATE DASHBOARD STATISTICHE (KPIs)
         */
        function updateKPIs() {
            document.getElementById('kpi-total').textContent = studentsList.length;

            if (studentsList.length === 0) {
                document.getElementById('kpi-avg-gpa').textContent = "0.00";
                document.getElementById('kpi-passed').textContent = "0";
                document.getElementById('kpi-top-city').textContent = "-";
                return;
            }

            // Calcolo Media Classe
            const sumGpa = studentsList.reduce((acc, s) => acc + s.mediaVoti, 0);
            const avgGpa = sumGpa / studentsList.length;
            document.getElementById('kpi-avg-gpa').textContent = avgGpa.toFixed(2);

            // Calcolo Sufficienti
            const passedCount = studentsList.filter(s => s.mediaVoti >= 6.0).length;
            document.getElementById('kpi-passed').textContent = `${passedCount} (${Math.round((passedCount/studentsList.length)*100)}%)`;

            // Calcolo Città Più Frequente
            const cityCounts = {};
            studentsList.forEach(s => {
                if (s.citta) cityCounts[s.citta] = (cityCounts[s.citta] || 0) + 1;
            });
            let topCity = "-";
            let maxCount = 0;
            for (const city in cityCounts) {
                if (cityCounts[city] > maxCount) {
                    maxCount = cityCounts[city];
                    topCity = city;
                }
            }
            document.getElementById('kpi-top-city').textContent = topCity;
        }

        /**
         * Popola la Select dinamica dei filtri Città
         */
        function populateCityFilterOptions() {
            const citySelect = document.getElementById('city-filter');
            const currentSelected = citySelect.value;
            
            // Estrae città uniche
            const cities = [...new Set(studentsList.map(s => s.citta).filter(Boolean))].sort();
            
            citySelect.innerHTML = '<option value="">Tutte le città</option>';
            cities.forEach(city => {
                const opt = document.createElement('option');
                opt.value = city;
                opt.textContent = city;
                citySelect.appendChild(opt);
            });

            citySelect.value = currentSelected;
        }

        /**
         * 7. EDITOR XML IN TEMPO REALE E UTILITIES
         */
        function toggleXmlEditor() {
            const panel = document.getElementById('xml-editor-panel');
            const btnText = document.getElementById('editor-toggle-text');
            
            if (panel.classList.contains('hidden')) {
                panel.classList.remove('hidden');
                btnText.textContent = "Chiudi Editor";
            } else {
                panel.classList.add('hidden');
                btnText.textContent = "Editor XML";
            }
        }

        function handleEditorInput() {
            const val = document.getElementById('xml-textarea').value;
            rawXmlString = val;
            parseAndProcessXml(val);
        }

        function formatXmlInEditor() {
            try {
                const parser = new DOMParser();
                const xmlDoc = parser.parseFromString(rawXmlString, "text/xml");
                if (xmlDoc.getElementsByTagName("parsererror").length > 0) {
                    showToast("Impossibile formattare: XML non valido", "error");
                    return;
                }
                const serializer = new XMLSerializer();
                const formatted = formatXmlString(serializer.serializeToString(xmlDoc));
                document.getElementById('xml-textarea').value = formatted;
                rawXmlString = formatted;
                showToast("XML formattato correttamente", "success");
            } catch (e) {
                showToast("Errore di formattazione XML", "error");
            }
        }

        function formatXmlString(xml) {
            let reg = /(>)(<)(\/*)/g;
            let w = xml.replace(reg, '$1\r\n$2$3');
            let pad = 0;
            let formatted = '';
            let lines = w.split('\r\n');
            for (let i = 0; i < lines.length; i++) {
                let indent = 0;
                let node = lines[i];
                if (node.match(/.+<\/\w[^>]*>$/)) {
                    indent = 0;
                } else if (node.match(/^<\/\w/)) {
                    if (pad != 0) pad -= 4;
                } else if (node.match(/^<\w[^>]*[^\/]>.*$/)) {
                    indent = 4;
                } else {
                    indent = 0;
                }
                let padding = '';
                for (let p = 0; p < pad; p++) padding += ' ';
                formatted += padding + node + '\r\n';
                pad += indent;
            }
            return formatted.trim();
        }

        function downloadXmlFile() {
            const blob = new Blob([rawXmlString], { type: 'text/xml' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'anagrafica_classe.xml';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            showToast("Download del file XML avviato", "info");
        }

        // Helpers UI (Loading, Date, Escape HTML, Toast)
        function showLoading(isLoading) {
            const loader = document.getElementById('table-loading');
            if (isLoading) loader.classList.remove('hidden');
            else loader.classList.add('hidden');
        }

        function formatDate(dateStr) {
            if (!dateStr) return "-";
            const parts = dateStr.split('-');
            if (parts.length === 3) {
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            return dateStr;
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;")
                      .replace(/'/g, "&#039;");
        }

        function debounce(func, wait) {
            let timeout;
            return function(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let bgClass = 'bg-slate-800 text-white';
            let icon = 'fa-circle-info';

            if (type === 'success') {
                bgClass = 'bg-emerald-600 text-white';
                icon = 'fa-circle-check';
            } else if (type === 'error') {
                bgClass = 'bg-rose-600 text-white';
                icon = 'fa-triangle-exclamation';
            } else if (type === 'warning') {
                bgClass = 'bg-amber-500 text-white';
                icon = 'fa-circle-exclamation';
            }

            toast.className = `${bgClass} pointer-events-auto px-4 py-3 rounded-lg shadow-xl text-sm font-medium flex items-center gap-2.5 transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="fa-solid ${icon}"></i> <span>${escapeHtml(message)}</span>`;

            container.appendChild(toast);

            // Animate in
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            // Remove after 3.5s
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
